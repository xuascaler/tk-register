    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
