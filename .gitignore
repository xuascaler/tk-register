# Track only reviewed application source and deployment definitions at the root.
# The production directory also contains private settings, certificates, backups,
# source archives, release staging, logs, and compiled artifacts.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Dockerfile
!/Dockerfile.aws
!/nginx.conf
!/nginx.aws.conf
!/aws-rds-ca/
!/start.sh
!/tk-register-web-portal/
/tk-register-web-portal/node_modules
/tk-register-web-portal/credential-helper/node_modules
